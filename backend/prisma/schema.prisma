// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  role      Role     @default(STUDENT)
  name      String
  email     String   @unique
  password  String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student?
  teacher  Teacher?
  admin    Admin?

  @@map("users")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model Student {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  age          Int
  dob          DateTime
  parentName   String
  phone        String
  class        Int      @default(1)
  language     Language @default(en)
  totalScore   Int      @default(0)
  createdAt    DateTime @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentAnswers  StudentAnswer[]
  remarks         Remark[]
  progress        Progress[]
  leaderboard     Leaderboard?

  @@map("students")
}

model Teacher {
  id     Int  @id @default(autoincrement())
  userId Int  @unique

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizzes  Quiz[]
  remarks  Remark[]

  @@map("teachers")
}

model Admin {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

enum Language {
  en
  hi
  pa
}

model Subject {
  id       Int    @id @default(autoincrement())
  name     String
  nameHi   String @default("")
  namePa   String @default("")
  class    Int
  isLang   Boolean @default(false)
  icon     String  @default("📚")

  chapters  Chapter[]
  quizzes   Quiz[]
  remarks   Remark[]
  progress  Progress[]

  @@map("subjects")
}

model Chapter {
  id        Int    @id @default(autoincrement())
  subjectId Int
  title     String
  titleHi   String @default("")
  titlePa   String @default("")
  order     Int    @default(1)

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  contents Content[]
  quizzes  Quiz[]

  @@map("chapters")
}

model Content {
  id        Int      @id @default(autoincrement())
  chapterId Int
  text      String
  videoUrl  String?
  language  Language
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("contents")
}

model Quiz {
  id        Int      @id @default(autoincrement())
  subjectId Int
  chapterId Int?
  teacherId Int
  title     String
  createdAt DateTime @default(now())

  subject   Subject    @relation(fields: [subjectId], references: [id])
  chapter   Chapter?   @relation(fields: [chapterId], references: [id])
  teacher   Teacher    @relation(fields: [teacherId], references: [id])
  questions Question[]

  @@map("quizzes")
}

model Question {
  id            Int    @id @default(autoincrement())
  quizId        Int
  question      String
  option1       String
  option2       String
  option3       String
  option4       String
  correctAnswer String
  marks         Int    @default(1)

  quiz           Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]

  @@map("questions")
}

model StudentAnswer {
  id            Int    @id @default(autoincrement())
  studentId     Int
  questionId    Int
  answer        String
  marksObtained Int    @default(0)
  createdAt     DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("student_answers")
}

model Remark {
  id         Int      @id @default(autoincrement())
  studentId  Int
  subjectId  Int
  teacherId  Int
  remarkText String
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("remarks")
}

model Progress {
  id                   Int   @id @default(autoincrement())
  studentId            Int
  subjectId            Int
  completionPercentage Int   @default(0)
  updatedAt            DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
  @@map("progress")
}

model Leaderboard {
  id        Int @id @default(autoincrement())
  studentId Int @unique
  class     Int
  score     Int @default(0)
  stars     Int @default(0)
  badges    Int @default(0)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("leaderboard")
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  expiry    DateTime
  createdAt DateTime @default(now())

  @@map("otp_verification")
}
